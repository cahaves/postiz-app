FROM node:22.20-bookworm-slim

ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION \
    NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    g++ \
    make \
    python3 \
    bash \
    nginx \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
    && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
    && mkdir -p /www \
    && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2@6.0.14

WORKDIR /app
COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
COPY var/docker/cahaves-start.sh /usr/local/bin/cahaves-start

RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm rebuild bcrypt \
    && pnpm exec prisma generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build
RUN chmod 0755 /usr/local/bin/cahaves-start

ENV NODE_ENV=production
EXPOSE 5000
CMD ["/usr/local/bin/cahaves-start"]
